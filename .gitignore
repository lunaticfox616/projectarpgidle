
# 생성 산출물(엑셀 내보내기)
*.xlsx

# 로컬 테스트 의존성과 브라우저 검사 산출물
node_modules/
.npm-cache/
playwright-report/
test-results/
# npm run probe(scripts/probe-save.js)의 기본 스크린숏 자리
probe-output/
debug.log

# Local reviews, captures and backups are retained on disk, not shipped in PRs.
/artifacts/*
!/artifacts/unlock-ui/
/artifacts/unlock-ui/*
!/artifacts/unlock-ui/test.html
!/artifacts/unlock-ui/test.css
!/artifacts/unlock-ui/test.js
!/artifacts/unlock-ui/test-bridge.js
!/artifacts/grove-ui/
/artifacts/grove-ui/*
!/artifacts/grove-ui/preview.html
!/artifacts/player-stall-review/
/artifacts/player-stall-review/*
!/artifacts/player-stall-review/index.html
!/artifacts/player-stall-review/fixture.js
!/artifacts/player-stall-review/balance-report.json

# Source art is retained locally; the game loads the compact WebP derivatives.
/assets/items/illustrated/*.png
/assets/effects/pixel-frost-erosion-sheet-v1.png
/assets/effects/skill-earth-spike-v1.png
__pycache__/
*.pyc

# Rebuilt Android web bundle, local SDK paths and signing material.
/www/
/dist/
*.apk
*.aab
*.jks
*.keystore

# Private art is restored locally from projectarpgidle-assets (see docs/github-publish-20261001.md).
/assets/playable/hana/
# 무대 스킬 이펙트 그림(scripts/build-stage-skill-vfx.cjs가 옮긴다): 구매 팩이라 다시 나눠 주면 안 된다. 비공개 저장소에만 두고,
# 배포할 때 그 저장소의 assets가 묶음에 들어간다. 나머지 무대 그림(주인공, 몬스터, NPC, 배경, 보스 효과)은 저장소에 있다.
/assets/stage-vfx/vfx.png
# 두 번째 묶음(2026-10-17 스킬룬 인계 v32: Met.Pxl Mega Pack, vfx_slash, magic_arrow, Effect Pack 1~7, 9). 같은 약관이다.
/assets/stage-vfx/vfx2.png
/assets/stage-vfx/vfx3.png
# 쓰지 않는 첫 무대 조각 키트(지금 배경은 assets/stage-scenes).
/assets/playable/stage/scenes/
/assets/summon/hana/
/docs/skill-assets-hana/reference/
