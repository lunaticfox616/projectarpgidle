{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": []
  },
  "include": [
    "modules/*/**/*.mjs"
  ]
}
